# ==========================================
# Frontend Configuration (Next.js)
# ==========================================

# URL của Backend NestJS (dùng cho Next.js rewrites /api/v1 và /uploads)
# Lưu ý: Backend đang chạy ở port 9000 (mặc định trong next.config.ts là 5000 nên cần cấu hình ở đây)
NEXT_PUBLIC_API_URL=http://localhost:9000

# ==========================================
# Optional App Settings
# ==========================================
# NODE_ENV=development
# PORT=3000
# HOST=127.0.0.1
